# ── SUPABASE ──────────────────────────────────────────
# Obtené estos valores en: https://supabase.com → tu proyecto → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...   # Service Role Key (no la anon)

# ── JWT ───────────────────────────────────────────────
# Generá una clave segura: openssl rand -base64 64
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_segura_123456

# ── APP ───────────────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://tu-dominio.com

# ── EMAIL (opcional, para notificar a inversores) ─────
# Usá Gmail con contraseña de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hola@digsa.es
SMTP_PASS=tu_contrasena_de_aplicacion
